#include <windows.h>

// 1. Primary Application Icon
101 ICON "app.ico"

// 2. Application Manifest (Per-Monitor V2 DPI Awareness & Windows 10/11)
1 RT_MANIFEST "app.manifest"

// 3. Native Windows Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FFXIV Hub Contributors\0"
            VALUE "FileDescription",  "FFXIV Hub Unified Desktop Manager\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "ffxiv-hub\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "ffxiv-hub.exe\0"
            VALUE "ProductName",      "FFXIV Hub\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
